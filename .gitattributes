# Bundled extension files stay byte-exact (pinned by hash).
boring-core/components/boring/webstore/chromium-web-store/** -text
# Patches are applied to the Chromium tree, which uses LF. With
# core.autocrlf on, a checkout or a stash pop writes them with CRLF and
# they stop applying, so keep them LF on every machine.
*.patch text eol=lf
**/patches/series text eol=lf
# A test reads Cargo.lock for a two line pattern, so a CRLF checkout fails it.
**/Cargo.lock text eol=lf
# Vendored Chromium data files, byte-exact (hashes in boring-core/tools/data/SOURCES.txt).
boring-core/tools/data/effective_tld_names.dat -text
boring-core/tools/data/domains.list -text
