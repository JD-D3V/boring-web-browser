static_library("ai") {
  sources = [
    "ai_prefs.cc",
    "ai_prefs.h",
    "ai_summary_service.cc",
    "ai_summary_service.h",
    "ai_ui.cc",
    "ai_ui.h",
  ]
  deps = [
    "//base",
    "//components/pref_registry",
    "//components/prefs",
    "//components/user_prefs",
    "//content/public/browser",
    "//content/public/common",
    "//net",
    "//net/traffic_annotation",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]

  # DPAPI, used to encrypt the AI key before it is written to the profile.
  if (is_win) {
    libs = [ "crypt32.lib" ]
  }
}
