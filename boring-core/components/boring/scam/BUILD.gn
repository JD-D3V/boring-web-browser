static_library("scam") {
  sources = [
    "scam_blocking_page.cc",
    "scam_blocking_page.h",
    "scam_controller_client.cc",
    "scam_controller_client.h",
    "scam_navigation_throttle.cc",
    "scam_navigation_throttle.h",
    "scam_service.cc",
    "scam_service.h",
  ]
  # chrome/browser already depends on this target. The scam guards ride
  # along with it rather than adding a line to chrome/browser/BUILD.gn,
  # which several patches edit.
  public_deps = [ "//components/boring/guards" ]
  deps = [
    "//base",
    "//components/boring/adblock:browser",
    "//components/boring/core",
    "//components/boring/lists",
    "//components/security_interstitials/content:security_interstitial_page",
    "//components/security_interstitials/core",
    "//components/user_prefs",
    "//content/public/browser",
    "//net",
    "//ui/base",
    "//ui/color",
    "//ui/color:color_headers",
    "//ui/gfx",
    "//url",
  ]
}
