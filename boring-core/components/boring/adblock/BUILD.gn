import("//build/buildflag_header.gni")

declare_args() {
  # A release build must refuse to load an engine that is not signed,
  # and the refusal must not be something an attacker can switch off by
  # deleting a signature. A developer build cannot require one, because
  # there is no certificate on a developer's machine. So the strict rule
  # is a build setting the release job turns on, not something worked
  # out at runtime from the browser's own state.
  boring_require_signed_engine = false

  # The exact name on the certificate we sign with, as Windows displays
  # it, for example "JD Software Ltd". When this is set the engine must
  # be signed by that publisher and nobody else. Left empty, the engine
  # only has to be signed by whoever signed the browser, which still
  # shuts out any other trusted signer but cannot tell a release
  # certificate from a test one.
  boring_signing_subject = ""
}

buildflag_header("buildflags") {
  header = "buildflags.h"
  flags = [
    "BORING_REQUIRE_SIGNED_ENGINE=$boring_require_signed_engine",
    "BORING_SIGNING_SUBJECT=\"$boring_signing_subject\"",
  ]
}

# The Rust ad block engine is built by cargo (boring-core/rust) into a
# DLL that apply.py copies into lib/ here. We do not link against it.
# adblock_ffi.cc loads it by hand at first use, in the browser process
# only, so sandboxed processes never load unsigned code.

copy("adblock_dll") {
  sources = [ "lib/boring_adblock.dll" ]
  outputs = [ "$root_out_dir/boring_adblock.dll" ]
}

static_library("browser") {
  sources = [
    "adblock_checker_impl.cc",
    "adblock_checker_impl.h",
    "adblock_ffi.cc",
    "adblock_ffi.h",
    "adblock_service.cc",
    "adblock_service.h",
    "adblock_throttle.cc",
    "adblock_throttle.h",
    "blocking_off_sites.cc",
    "blocking_off_sites.h",
  ]
  deps = [
    ":buildflags",
    "//base",
    "//components/boring/adblock/mojom",
    "//components/boring/core",
    "//components/boring/lists",
    "//components/prefs",
    "//components/user_prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/common",
    "//url",
  ]
  data_deps = [ ":adblock_dll" ]

  # WinVerifyTrust checks the engine is signed before we load it, and
  # crypt32 reads back who signed it.
  if (is_win) {
    libs = [
      "crypt32.lib",
      "wintrust.lib",
    ]
  }
}

static_library("renderer") {
  sources = [
    "renderer/adblock_renderer_throttle.cc",
    "renderer/adblock_renderer_throttle.h",
  ]
  deps = [
    "//base",
    "//components/boring/adblock/mojom",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public:blink",
    "//third_party/blink/public/common",
    "//url",
  ]
}
