# The Rust ad block engine is built by cargo (boring-core/rust) into a
# DLL. apply.py copies the DLL and its import library into lib/ here.

config("ffi_link") {
  libs = [
    rebase_path("lib/boring_adblock.dll.lib"),
    "delayimp.lib",
  ]

  # Load the DLL only when an engine call is first made. Only the
  # browser process makes those calls. Without this, the sandboxed
  # renderer processes would try to load the DLL at startup and be
  # killed by the sandbox's signed code rule.
  ldflags = [ "/DELAYLOAD:boring_adblock.dll" ]
}

copy("adblock_dll") {
  sources = [ "lib/boring_adblock.dll" ]
  outputs = [ "$root_out_dir/boring_adblock.dll" ]
}

static_library("browser") {
  sources = [
    "adblock_checker_impl.cc",
    "adblock_checker_impl.h",
    "adblock_ffi.h",
    "adblock_service.cc",
    "adblock_service.h",
    "adblock_throttle.cc",
    "adblock_throttle.h",
  ]
  deps = [
    "//base",
    "//components/boring/adblock/mojom",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/common",
    "//url",
  ]
  public_configs = [ ":ffi_link" ]
  data_deps = [ ":adblock_dll" ]
}

static_library("renderer") {
  sources = [
    "renderer/adblock_renderer_throttle.cc",
    "renderer/adblock_renderer_throttle.h",
  ]
  deps = [
    "//base",
    "//components/boring/adblock/mojom",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//third_party/blink/public/common",
    "//url",
  ]
}
