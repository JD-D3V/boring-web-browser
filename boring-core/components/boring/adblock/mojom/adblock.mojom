module boring.mojom;

import "url/mojom/url.mojom";

// Lets a renderer ask the browser whether the ad blocker wants to block
// a request. The engine and the filter lists live only in the browser
// process.
interface AdblockChecker {
  // request_type uses the filter list names: script, image, stylesheet,
  // subdocument, xmlhttprequest, font, media, websocket, ping, other.
  // top_frame_url is the page in the tab, empty when the renderer cannot
  // tell; it decides whether the person turned blocking off there.
  //
  // `redirect` is set only when `block` is: a data: URL holding the
  // harmless stand-in a $redirect rule names, to serve instead of the
  // blocked request.
  Check(url.mojom.Url url, url.mojom.Url initiator, string request_type,
        url.mojom.Url top_frame_url) => (bool block, string? redirect);

  // Binds another checker, used when a throttle provider is cloned for
  // a new worker thread.
  Clone(pending_receiver<AdblockChecker> receiver);
};

// What to hide and run in one frame, from the cosmetic rules (##, #?#,
// ##+js) of every list in use for the page.
struct UrlCosmeticResources {
  array<string> hide_selectors;
  array<string> procedural_actions;  // adblock-rust JSON, one per entry
  array<string> exceptions;
  string injected_script;            // main world, document start
  bool generichide;
};

// Cosmetic filtering for a renderer. Bound per render process, with the
// profile, so it sees the sites with blocking turned off and the cookie
// notice and regional list choices.
interface CosmeticFilters {
  // Null when blocking is off for top_frame_url or the engine is not ready.
  // Sync because the scriptlets have to be in place before the page's
  // own scripts run.
  [Sync] GetUrlResources(url.mojom.Url frame_url, url.mojom.Url top_frame_url)
      => (UrlCosmeticResources? resources);

  // Generic hide rules (##.class, ###id) that match the given class names
  // and ids, which are passed without the leading . or #. `exceptions`
  // is the list from GetUrlResources.
  GetHiddenClassIdSelectors(array<string> classes, array<string> ids,
      array<string> exceptions, url.mojom.Url top_frame_url)
      => (array<string> selectors);
};

// The element picker, in the renderer. Bound per main frame as an
// associated interface, so it is ordered with the frame's navigations.
// Started by the browser from the toolbar shield's "Block this element".
interface ElementPicker {
  // Shows the picker on the page. Answers with the CSS selector the
  // person chose to block, already hidden on the page, or an empty
  // string when they cancelled, the page could not be picked (not http
  // or https) or went away.
  Start() => (string selector);
};

// Test only. Lets a page loaded with the address fragment
// #boring-test-element-picker ask the browser to start the picker on
// itself, so a smoke test can drive the picker with WebDriver alone.
// The browser binds it only when run with --boring-element-picker-test.
interface ElementPickerTestHook {
  StartPicker();
};
