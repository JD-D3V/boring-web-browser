# Copyright 2026 boring. BSD style license.

# What we owe the people whose code this browser is built from.
#
# The full third party notices are already inside resources.pak and show
# at chrome://credits, but somebody who unpacks the zip and never runs
# the browser should still be able to read them, and a licence that can
# only be read by running the software is a poor way to meet a licence.
# So both go in the folder beside chrome.exe as ordinary files.
#
# NOTICES.html is about twenty megabytes of plain HTML and compresses to
# roughly a tenth of that in the zip.

if (is_official_build) {
  copy("license") {
    sources = [ "//LICENSE" ]
    outputs = [ "$root_out_dir/LICENSE" ]
  }

  # Our own code's licence (MIT), beside Chromium's. apply.py copies it
  # here from the repository's LICENSE, so there is one copy to edit.
  copy("boring_license") {
    sources = [ "LICENSE-BoringBrowser.txt" ]
    outputs = [ "$root_out_dir/LICENSE-BoringBrowser.txt" ]
  }

  copy("third_party_notices") {
    # Generated by //components/resources:about_credits, which only
    # exists in an official build. That is the same file chrome://credits
    # shows, so the two can never disagree.
    sources = [ "$root_gen_dir/components/resources/about_credits.html" ]
    outputs = [ "$root_out_dir/NOTICES.html" ]
    deps = [ "//components/resources:about_credits" ]
  }

  # Chromium's generated credits cover Chromium's own third party tree.
  # The blocking engine is a separate Rust build, so none of its crates
  # appear there: NOTICES.html contains the string "adblock" zero times.
  # This file names every crate, its version, its licence and where its
  # source is. Regenerate it with tools/make_rust_notices.py after any
  # change to rust/Cargo.lock.
  copy("rust_notices") {
    sources = [ "NOTICES-rust.html" ]
    outputs = [ "$root_out_dir/NOTICES-rust.html" ]
  }

  # Chromium Web Store's MIT licence and the one for the XML parser
  # inside it. Written by tools/get_chromium_web_store.py.
  copy("chromium_web_store_notices") {
    sources = [ "NOTICES-chromium-web-store.txt" ]
    outputs = [ "$root_out_dir/NOTICES-chromium-web-store.txt" ]
  }

  # The en-US spelling dictionary's own notice (SCOWL and the word lists
  # it is built from). NOTICES.html names "hunspell dictionaries" with
  # the licence that covers the other languages, not this one.
  copy("hunspell_en_us_notice") {
    sources = [ "//third_party/hunspell_dictionaries/README_en_US.txt" ]
    outputs = [ "$root_out_dir/NOTICES-hunspell-en-US.txt" ]
  }

  group("notices") {
    public_deps = [
      ":boring_license",
      ":chromium_web_store_notices",
      ":hunspell_en_us_notice",
      ":hunspell_en_us",
      ":license",
      ":rust_notices",
      ":third_party_notices",
    ]
  }
} else {
  # A developer build has no generated credits file to copy. Say so
  # rather than silently shipping nothing. The dictionary still goes in,
  # so spelling works the same in both.
  group("notices") {
    public_deps = [ ":hunspell_en_us" ]
  }
}

# The Hunspell en-US dictionary, so spelling works with no download:
# ungoogled-chromium blocks Chromium's dictionary download. Windows' own
# spellchecker is used first; this is for when Windows has no English
# spelling data. It lives in Dictionaries beside chrome.dll, which is
# where the spellcheck-dictionary-dir patch points DIR_APP_DICTIONARIES
# (beside chrome.exe in the zip, the version folder once installed).
# Not really a notice, but this is the one target components/boring/core
# already pulls in as data.
copy("hunspell_en_us") {
  sources = [ "//third_party/hunspell_dictionaries/en-US-10-1.bdic" ]
  outputs = [ "$root_out_dir/Dictionaries/en-US-10-1.bdic" ]
}
