@@ -48,7 +48,14 @@
   switch (metric) {
     case views::INSETS_DIALOG:
     case views::INSETS_DIALOG_SUBSECTION: {
-      return gfx::Insets::VH(20, 20);
+      // boring: 24 DIP, matching the reference's popover padding. This is
+      // the shared content margin for dialogs and bubbles that don't set
+      // their own (DialogDelegate::GetContentsInsets() and
+      // BubbleDialogDelegateView both read INSETS_DIALOG when no
+      // per-instance margins were set), so it reaches the app menu's
+      // fallback layout, the downloads bubble, page info and the
+      // bookmark bubble without touching each one's own controller.
+      return gfx::Insets::VH(24, 24);
     }
     case views::INSETS_DIALOG_FOOTNOTE: {
       return gfx::Insets::TLBR(10, 20, 15, 20);
@@ -97,6 +104,20 @@
   DCHECK_GE(metric, views::VIEWS_DISTANCE_START);
   DCHECK_LT(metric, views::VIEWS_DISTANCE_MAX);
 
+  switch (metric) {
+    case views::DISTANCE_DIALOG_CONTENT_MARGIN_TOP_TEXT:
+    case views::DISTANCE_DIALOG_CONTENT_MARGIN_BOTTOM_TEXT:
+      // boring: 24 DIP top and bottom, matching the reference's uniform
+      // popover padding and INSETS_DIALOG's 24 DIP left/right above
+      // (BubbleDialogDelegate combines this with INSETS_DIALOG in
+      // LayoutProvider::GetDialogInsetsForContentType() for its default
+      // contents margins), instead of Chromium's asymmetric 8-top /
+      // 16-bottom text margins.
+      return 24;
+    default:
+      break;
+  }
+
   if (metric < views::VIEWS_DISTANCE_END) {
     return LayoutProvider::GetDistanceMetric(metric);
   }
