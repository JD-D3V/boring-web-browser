+// boring: a pressed toolbar button settles to 94% of its size, as in the
+// approved mock, and springs back on release. It only changes a layer
+// transform, so it never touches input: the click is dispatched on release
+// exactly as before. A new press or release retargets from wherever the
+// last one had got to, so it can be interrupted at any moment. It is
+// skipped when animation effects are off, and for buttons that show text,
+// whose text would lose its subpixel rendering on a layer.
+void AnimateToolbarButtonPress(ToolbarButton* button, bool pressed) {
+  if (!gfx::Animation::ShouldRenderRichAnimation() ||
+      gfx::Animation::PrefersReducedMotion() || !button->GetText().empty()) {
+    return;
+  }
+  if (!button->layer()) {
+    if (!pressed) {
+      return;
+    }
+    button->SetPaintToLayer();
+    button->layer()->SetFillsBoundsOpaquely(false);
+  }
+  const gfx::Transform target =
+      pressed ? gfx::GetScaleTransform(button->GetLocalBounds().CenterPoint(),
+                                       0.94f)
+              : gfx::Transform();
+  views::AnimationBuilder()
+      .SetPreemptionStrategy(
+          ui::LayerAnimator::IMMEDIATELY_ANIMATE_TO_NEW_TARGET)
+      .Once()
+      .SetDuration(base::Milliseconds(pressed ? 70 : 120))
+      .SetTransform(button->layer(), target, gfx::Tween::EASE_OUT);
+}
