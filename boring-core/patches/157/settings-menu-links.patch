diff --git a/chrome/browser/resources/settings/settings_menu/settings_menu.css b/chrome/browser/resources/settings/settings_menu/settings_menu.css
--- a/chrome/browser/resources/settings/settings_menu/settings_menu.css
+++ b/chrome/browser/resources/settings/settings_menu/settings_menu.css
@@ -17,6 +17,21 @@
   display: block;
   padding-bottom: 5px; /* Prevents focus outlines from being cropped. */
   padding-top: 8px;
+  --boring-ink: var(--color-dialog-foreground, #242e2d);
+  --boring-muted: var(--color-label-foreground-secondary, #5d6966);
+  --boring-line: var(--color-bubble-border, #d8ddd7);
+  --boring-accent: var(--color-sys-primary, #176b5b);
+  --boring-soft: var(--color-sys-primary-container, #e5f1eb);
+}
+
+@media (prefers-color-scheme: dark) {
+  :host {
+    --boring-ink: var(--color-dialog-foreground, #e8ede7);
+    --boring-muted: var(--color-label-foreground-secondary, #adb9b2);
+    --boring-line: var(--color-bubble-border, #414e47);
+    --boring-accent: var(--color-sys-primary, #92d4bb);
+    --boring-soft: var(--color-sys-primary-container, #273f35);
+  }
 }
 
 :host-context([settings-refresh-2026]) .cr-nav-menu-item {
@@ -54,10 +69,15 @@
 }
 
 #menu {
-  color: var(--google-grey-700);
+  color: var(--boring-ink);
   display: flex;
   flex-direction: column;
-  min-width: fit-content;
+  /* max-content, not fit-content: the sidebar (#left, settings_ui.html)
+     is asked to grow to fit the longest label rather than let one
+     wrap, so the menu's own minimum has to reflect its real content
+     width instead of clamping to whatever width it happens to be
+     given. */
+  min-width: max-content;
 }
 
 :host-context([settings-refresh-2026]) #menu {
@@ -70,20 +90,98 @@
   width: var(--cr-icon-size);
 }
 
+/* boring: no leading icons in the nav. The visible label is still
+   the accessible name, so hiding these loses nothing. */
+.cr-nav-menu-item > cr-icon {
+  display: none;
+}
+
+.cr-nav-menu-item {
+  --cr-nav-menu-item-color: var(--boring-ink);
+  --cr-nav-menu-item-color-selected: var(--boring-accent);
+  --cr-nav-menu-item-background-color-hover: var(--boring-soft);
+  --cr-nav-menu-item-background-color-selected: var(--boring-soft);
+  border-radius: 9px;
+  border-start-start-radius: 9px;
+  border-start-end-radius: 9px;
+  border-end-start-radius: 9px;
+  border-end-end-radius: 9px;
+  font-size: 13px;
+  font-weight: 400;
+  margin-block-end: 5px;
+  margin-inline-end: 0;
+  margin-inline-start: 0;
+  min-height: unset;
+  padding-block-end: 11px;
+  padding-block-start: 11px;
+  padding-inline-end: 12px;
+  padding-inline-start: 12px;
+  white-space: nowrap;
+  width: 100%;
+}
+
+.cr-nav-menu-item[selected] {
+  font-weight: 600;
+}
+
+/* boring: cr-nav-menu-item-style's own :focus rule (not included via
+   settings-shared here, so cr-shared-style's [selectable]:focus-visible
+   accent ring never reaches this file) leaves the browser's native
+   outline showing, which renders as a plain dark ring instead of our
+   accent. Keyboard focus should never be invisible or default-styled. */
+.cr-nav-menu-item:focus-visible {
+  outline: 2px solid var(--boring-accent);
+  outline-offset: 2px;
+}
+
+@media (forced-colors: active) {
+  .cr-nav-menu-item:focus-visible {
+    outline-color: Highlight;
+  }
+}
+
+/* boring: small group caption after the browser's own categories,
+   as in the V2 design. Hidden in the narrow horizontal strip. */
+.nav-group {
+  color: var(--boring-muted);
+  font-size: 10px;
+  font-weight: 600;
+  letter-spacing: 0.12em;
+  margin: 22px 12px 8px;
+  text-transform: uppercase;
+  white-space: nowrap;
+}
+
 .menu-separator {
-  /* Per bettes@, this is different from the other separator lines. */
-  border-bottom: 1px solid rgba(0, 0, 0, 0.08);
+  border-bottom: 1px solid var(--boring-line);
   margin-bottom: 8px;
   margin-top: 8px;
 }
 
-@media (prefers-color-scheme: dark) {
+/* boring: the demo's narrow settings breakpoint (same 800px as
+   settings_ui's #main and UI_V1_DEMO_CONTRACT.md), turning the
+   vertical list into a horizontal scrolling strip of pills. This only
+   changes how the menu lays out its own items; whether it's actually
+   visible at this width (instead of the stock hidden-sidebar-plus-
+   drawer pattern) is settings_ui's call, see for-D1.md. */
+@media (max-width: 800px) {
   #menu {
-    color: var(--cr-primary-text-color);
+    flex-direction: row;
+    gap: 8px;
+    /* Let the row shrink below its content width so overflow-x can
+       actually scroll, instead of forcing the sidebar wider. */
+    min-width: 0;
+    overflow-x: auto;
+  }
+
+  .cr-nav-menu-item {
+    flex-shrink: 0;
+    margin-block-end: 0;
+    width: auto;
   }
 
-  .menu-separator {
-    border-bottom: var(--cr-separator-line);  /* override */
+  .nav-group {
+    display: none;
   }
 }
 
