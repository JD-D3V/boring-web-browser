+void TabGroupHeaderView::BoringUpdateCount() {
+  if (!boring_count_label_ || !delegate_->IsValid()) {
+    return;
+  }
+  const int count = delegate_->GetTabGroup().tab_count();
+  boring_count_label_->SetText(
+      base::NumberToString16(count) + (count == 1 ? u" tab" : u" tabs"));
+}
+
 void TabGroupHeaderView::OnTabCountChanged() {
