+void TabGroupHeaderView::BoringUpdateCount() {
+  if (!boring_count_label_ || !delegate_->IsValid()) {
+    return;
+  }
+  const int count = delegate_->GetTabGroup().tab_count();
+  boring_count_label_->SetText(
+      base::NumberToString16(count) + (count == 1 ? u" tab" : u" tabs"));
+}
+
 void TabGroupHeaderView::OnTabCountChanged() {
+  // boring: the side tabs heading's "N tabs".
+  BoringUpdateCount();
   if (delegate_->IsValid() && delegate_->GetTabGroup().is_ephemeral()) {
     const int tab_count = delegate_->GetTabGroup().tab_count();
     group_header_label_->SetText(l10n_util::GetPluralStringFUTF16(
@@ -690,6 +745,14 @@
   }
 
   // Update background.
+  // boring: in side tabs only the label is filled, a 7-cornered chip; the
+  // row stays clear (screen C09).
+  if (orientation_ == TabStripOrientation::kVertical) {
+    group_header_label_->SetBackground(
+        views::CreateRoundedRectBackground(background_color, 7));
+    SetBackground(nullptr);
+    return;
+  }
   SetBackground(
       views::CreateRoundedRectBackground(background_color, GetCornerRadii()));
 }
