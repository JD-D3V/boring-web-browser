+                  [](char c) { return base::IsHexDigit(c); })) {
+    SkColor rgb = 0;
+    for (size_t i = 1; i < boring_accent.size(); ++i) {
+      rgb = rgb * 16 + base::HexDigitToInt(boring_accent[i]);
+    }
+    key.boring_accent = SkColorSetA(rgb, SK_AlphaOPAQUE);
+  }
