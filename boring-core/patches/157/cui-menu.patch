+  --cr-toggle-checked-bar-color: var(--color-sys-primary);
+  --cr-toggle-checked-button-color: #fff;
+  --cr-toggle-unchecked-bar-color: var(--color-boring-edge);
+  --cr-toggle-unchecked-button-color: #fff;
+  --cr-toggle-track-border-color: transparent;
+}
