+// boring: "Save all tabs" is a browser command, not a tab strip one, so it
+// goes to the tab's window before any id is read as a tab strip command.
+BrowserWindowInterface* WindowOf(tabs::TabHandle handle) {
+  tabs::TabInterface* tab = handle.Get();
+  return tab ? tab->GetBrowserWindowInterface() : nullptr;
+}
+
+bool CanSaveAllTabs(tabs::TabHandle handle) {
+  BrowserWindowInterface* window = WindowOf(handle);
+  return window && chrome::IsCommandEnabled(window, IDC_BORING_SAVE_ALL_TABS);
+}
+
+}  // namespace
