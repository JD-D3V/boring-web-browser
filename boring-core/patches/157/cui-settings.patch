+
+/* boring: cui-settings. Settings, Appearance as drawn (design v12-compiled
+ * PageSettings). Colours come from the master window's TOKENS rows (light,
+ * then dark); outlines of fields and outline buttons use the edge token. */
+:host {
+  --cui-surface: #ffffff;
+  --cui-field: #f4f3ef;
+  --cui-line: #e2dfd9;
+  --cui-line2: #d0ccc4;
+  --cui-edge: #8a867d;
+  --cui-ink2: #5d5a54;
+}
+
+@media (prefers-color-scheme: dark) {
+  :host {
+    --cui-surface: #1c1c1a;
+    --cui-field: #121211;
+    --cui-line: #2d2d2a;
+    --cui-line2: #3b3b37;
+    --cui-edge: #77756d;
+    --cui-ink2: #a9a79f;
+  }
+}
+
+.boring-subline {
+  color: var(--cui-ink2);
+  font-size: 13px;
+  margin: 0 0 4px;
+  padding-block-start: 4px;
+  padding-inline: var(--cr-section-padding);
+}
+
+.cui-title {
+  font-weight: 500;
+}
+
+.cui-segmented {
+  background: var(--cui-field);
+  border-radius: 8px;
+  box-shadow: inset 0 0 0 1px var(--cui-line);
+  display: flex;
+  padding: 3px;
+}
+
+.cui-mode {
+  background: none;
+  border: 0;
+  border-radius: 6px;
+  color: var(--cui-ink2);
+  cursor: pointer;
+  font: inherit;
+  font-size: 13px;
+  height: 30px;
+  padding: 0 14px;
+}
+
+.cui-mode[aria-pressed='true'] {
+  background: var(--cui-surface);
+  box-shadow: 0 0 0 1px var(--cui-line2);
+  color: inherit;
+  font-weight: 500;
+}
+
+.cui-look-row {
+  display: flex;
+  flex-direction: column;
+  gap: 12px;
+  padding: 14px var(--cr-section-padding);
+}
+
+.cui-looks {
+  display: grid;
+  gap: 12px;
+  grid-template-columns: repeat(3, minmax(0, 1fr));
+}
+
+.cui-look {
+  background: none;
+  border: 0;
+  border-radius: 9px;
+  box-shadow: inset 0 0 0 1px var(--cui-line);
+  color: inherit;
+  cursor: pointer;
+  display: flex;
+  flex-direction: column;
+  font: inherit;
+  gap: 8px;
+  padding: 8px 8px 9px;
+  text-align: start;
+}
+
+.cui-look[aria-pressed='true'] {
+  box-shadow: inset 0 0 0 2px var(--boring-accent);
+}
+
+/* Each preview is a small picture of that Look's window, in its colours. */
+.cui-preview {
+  background: var(--p-frame);
+  border-radius: 6px;
+  box-shadow: inset 0 0 0 1px var(--p-edge);
+  display: flex;
+  flex-direction: column;
+  height: 72px;
+  overflow: hidden;
+}
+
+.cui-preview.soft_white {
+  --p-frame: #eceae6;
+  --p-bar: #ffffff;
+  --p-page: #f8f7f4;
+  --p-field: #f4f3ef;
+  --p-edge: #d0ccc4;
+}
+
+.cui-preview.slate {
+  --p-frame: #e6e8ee;
+  --p-bar: #ffffff;
+  --p-page: #f5f6f8;
+  --p-field: #eceef2;
+  --p-edge: #cfd2da;
+}
+
+.cui-preview.dusk {
+  --p-frame: #0f1017;
+  --p-bar: #1b1d2b;
+  --p-page: #141520;
+  --p-field: #262838;
+  --p-edge: #34364a;
+}
+
+.cui-tabs {
+  align-items: flex-end;
+  display: flex;
+  gap: 3px;
+  height: 13px;
+  padding-inline-start: 6px;
+}
+
+.cui-tabs span {
+  background: var(--p-bar);
+  border-radius: 3px 3px 0 0;
+  height: 8px;
+  width: 34px;
+}
+
+.cui-tabs span + span {
+  background: var(--p-edge);
+}
+
+.cui-bar {
+  align-items: center;
+  background: var(--p-bar);
+  display: flex;
+  height: 15px;
+  padding: 0 6px;
+}
+
+.cui-bar span {
+  background: var(--p-field);
+  border-radius: 3px;
+  flex: 1;
+  height: 7px;
+}
+
+.cui-page {
+  background: var(--p-page);
+  flex: 1;
+}
+
+.cui-label {
+  align-items: baseline;
+  display: flex;
+  gap: 8px;
+  padding: 0 2px;
+}
+
+.cui-label .secondary {
+  font-size: 12.5px;
+}
+
+.cui-accents {
+  align-items: center;
+  display: flex;
+  gap: 10px;
+}
+
+.cui-dot {
+  background: var(--cui-dot);
+  border: 0;
+  border-radius: 12px;
+  cursor: pointer;
+  height: 24px;
+  padding: 0;
+  width: 24px;
+}
+
+/* Dots under 3 to 1 against the dark card get an edge ring there. */
+@media (prefers-color-scheme: dark) {
+  .cui-dot.low {
+    box-shadow: 0 0 0 1px var(--cui-edge);
+  }
+}
+
+.cui-dot[aria-pressed='true'] {
+  box-shadow: 0 0 0 2px var(--cui-surface), 0 0 0 4px var(--cui-dot);
+}
+
+.cui-outline {
+  align-items: center;
+  border-radius: 7px;
+  box-shadow: inset 0 0 0 1px var(--cui-edge);
+  box-sizing: border-box;
+  cursor: pointer;
+  display: inline-flex;
+  font-size: 13px;
+  font-weight: 500;
+  height: 32px;
+  padding: 0 12px;
+}
+
+.cui-custom {
+  height: 30px;
+  margin-inline-start: 6px;
+  position: relative;
+}
+
+.cui-custom.on {
+  box-shadow: inset 0 0 0 2px var(--cui-dot);
+}
+
+.cui-custom:focus-within {
+  outline: 2px solid var(--cr-focus-outline-color);
+  outline-offset: 2px;
+}
+
+/* The colour field covers the button, so a click opens its picker. */
+.cui-custom input {
+  border: 0;
+  cursor: pointer;
+  height: 100%;
+  inset: 0;
+  opacity: 0;
+  padding: 0;
+  position: absolute;
+  width: 100%;
+}
+
+#customizeToolbar {
+  --cr-button-border: 1px solid var(--cui-edge);
+  --cr-button-border-radius: 7px;
+  --cr-button-height: 32px;
+  box-shadow: none;
+  font-size: 13px;
+  font-weight: 500;
+}
+
+#resetPinnedToolbarActions {
+  margin-inline-end: 8px;
+}
+
+#tabsRow settings-dropdown-menu::part(select),
+#bookmarksRow settings-dropdown-menu::part(select) {
+  border-color: var(--cui-edge);
+  border-radius: 7px;
+  font-size: 13px;
+  font-weight: 500;
+  height: 32px;
+  width: auto;
+}
