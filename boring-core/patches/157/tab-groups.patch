@@ -86,3 +87,31 @@
 int TabGroupStyle::GetLeadingGroupHeaderPadding() {
   return TabStyle::Get()->GetTabOverlap() - GetTabGroupOverlapAdjustment();
 }
+
+// boring: the compiled design's group wash, 15% of the group colour over
+// white on a light strip and 22% over black on a dark one. The tab titles
+// on it keep their own colour, so it stays light in light and dark in dark.
+// static
+SkColor TabGroupStyle::GetTabTint(SkColor group_color, SkColor strip_color) {
+  const bool dark = color_utils::IsDark(strip_color);
+  return color_utils::AlphaBlend(group_color,
+                                 dark ? SK_ColorBLACK : SK_ColorWHITE,
+                                 dark ? 0.22f : 0.15f);
+}
+
+// boring: 6 DIP before the label chip, as drawn.
+// static
+int TabGroupStyle::GetTabTintHeaderInset() {
+  return GetLeadingGroupHeaderPadding() - 6;
+}
+
+// boring: a top tab paints its shape inset by the bottom corner radius,
+// and neighbours sit a separator's width plus its margins apart.
+// static
+int TabGroupStyle::GetTabTintTabInset() {
+  const TabStyle* const style = TabStyle::Get();
+  return style->GetBottomCornerRadius() -
+         (style->GetSeparatorMargins().width() +
+          style->GetSeparatorSize().width()) /
+             2;
+}
