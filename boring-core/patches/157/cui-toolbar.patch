+  boring_protection_ = AddChildView(std::move(view));
+  ReorderViews();
+  return boring_protection_;
+}
+
 void PinnedToolbarActionsContainer::ReorderViews() {
   size_t index = 0;
   // Pinned buttons appear first. Use the model's ordering of pinned ActionIds
   // because |pinned_buttons_| ordering is not updated on changes from the model
   // or from the user dragging to reorder.
   const auto ordered_pinned_ids = model_->PinnedActionIds();
+  // boring: the shield leads, or follows Forget while Forget is pinned.
+  const bool boring_after_forget =
+      boring_protection_ && GetPinnedButtonFor(kActionBoringForgetSession);
+  if (boring_protection_ && !boring_after_forget) {
+    ReorderChildView(boring_protection_, index++);
+  }
   for (auto id : ordered_pinned_ids) {
     if (auto* button = GetPinnedButtonFor(id)) {
       ReorderChildView(button, index);
       index++;
+      if (boring_after_forget && id == kActionBoringForgetSession) {
+        ReorderChildView(boring_protection_, index++);
+      }
     }
   }
 
