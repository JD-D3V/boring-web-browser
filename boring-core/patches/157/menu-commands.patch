@@ -1326,6 +1327,13 @@ void BrowserCommandController::HandleCommandWithDisposition(
     case IDC_OPTIONS:
       ShowSettings(webui::GetBrowserForOpeningWebUi(browser_));
       break;
+    case IDC_BORING_PROTECTION:
+      ShowSingletonTab(webui::GetBrowserForOpeningWebUi(browser_),
