       break;
@@ -2161,6 +2169,9 @@ void BrowserCommandController::UpdateSharedCommandsForIncognitoAvailability(
                                         !forced_incognito && !is_guest);
   command_updater->UpdateCommandEnabled(IDC_OPTIONS,
                                         !forced_incognito || is_guest);
+  command_updater->UpdateCommandEnabled(IDC_BORING_PROTECTION,
+                                        !forced_incognito || is_guest);
+  command_updater->UpdateCommandEnabled(IDC_BORING_FORGET_SESSION, true);
   command_updater->UpdateCommandEnabled(IDC_PERFORMANCE,
                                         !forced_incognito && !is_guest);
 }
diff --git a/chrome/browser/ui/toolbar/app_menu_model.cc b/chrome/browser/ui/toolbar/app_menu_model.cc
--- a/chrome/browser/ui/toolbar/app_menu_model.cc
+++ b/chrome/browser/ui/toolbar/app_menu_model.cc
@@ -2322,6 +2322,20 @@ void AppMenuModel::Build() {
 #endif
 #endif
 
+  // boring: whether scam and ad blocking are really working, and the
+  // protection switches. Sits next to Settings so it is easy to find.
+  AddItemWithIcon(IDC_BORING_PROTECTION, u"Protection",
+                  ui::ImageModel::FromVectorIcon(
+                      vector_icons::kShieldIcon, ui::kColorMenuIcon,
+                      ui::SimpleMenuModel::kDefaultIconSize));
+
+  // boring: closes every tab and window and clears this session's
+  // history and site data, after one question.
+  AddItemWithIcon(IDC_BORING_FORGET_SESSION, u"Forget this session",
+                  ui::ImageModel::FromVectorIcon(
+                      kDeleteIcon, ui::kColorMenuIcon,
+                      ui::SimpleMenuModel::kDefaultIconSize));
+
   AddItemWithStringIdAndVectorIcon(
       this, IDC_OPTIONS, IDS_SETTINGS,
       features::IsRoundedIconsEnabled() ? kSettingsIcon : kSettingsMenuOldIcon);
