+  /**
+   * boring: fills the Protection rows. Blocking and never sleep come from
+   * the browser, whether the site's cookies clear on close from Chromium's
+   * own site settings.
+   */
+  private loadBoringRules_() {
+    const origin = this.origin_;
+    this.boringSite_ = '';
+    sendWithPromise<BoringSiteRules>('boringGetSiteRules', origin)
+        .then((rules) => {
+          if (origin !== this.origin_) {
+            return;
+          }
+          this.boringBlockingOn_ = !rules.blockingOff;
+          this.boringNeverSleep_ = rules.neverSleep;
+          // The exception list, not getOriginPermissions(): that one
+          // cannot turn a clear on exit answer into a permission and
+          // stops the browser.
+          const cookies = ContentSettingsTypes.COOKIES;
+          Promise
+              .all([
+                this.browserProxy.getExceptionList(cookies),
+                this.browserProxy.getDefaultValueForContentType(cookies),
+              ])
+              .then(([exceptions, everySite]) => {
+                if (origin !== this.origin_) {
+                  return;
+                }
+                const pattern = this.boringCookiePattern_(rules.site);
+                const own = exceptions.find(
+                    (e) => e.origin === pattern && !e.embeddingOrigin &&
+                        !e.incognito);
+                this.boringClearOnClose_ =
+                    (own ? own.setting : everySite.setting) ===
+                    ContentSetting.SESSION_ONLY;
+                this.boringSite_ = rules.site;
+              });
+        });
+  }
+
+  /**
+   * The whole site, the way Chromium's own list writes it. An address or
+   * a bare host is exact.
+   */
+  private boringCookiePattern_(site: string): string {
+    const isDomain =
+        site.includes('.') && !site.includes(':') && !/^[\d.]+$/.test(site);
+    return isDomain ? `[*.]${site}` : site;
+  }
+
+  private onBoringBlockingChange_(e: CustomEvent<boolean>) {
+    this.boringBlockingOn_ = e.detail;
+    chrome.send('boringSetSiteRule', [this.origin_, 'blocking', e.detail]);
+  }
+
+  private onBoringNeverSleepChange_(e: CustomEvent<boolean>) {
+    this.boringNeverSleep_ = e.detail;
+    chrome.send('boringSetSiteRule', [this.origin_, 'neverSleep', e.detail]);
+  }
+
+  /**
+   * Clear on close is Chromium's own "clear on exit" cookie setting for the
+   * site, the one its cookies page lists, not a setting of ours.
+   */
+  private onBoringClearOnCloseChange_(e: CustomEvent<boolean>) {
+    this.boringClearOnClose_ = e.detail;
+    const pattern = this.boringCookiePattern_(this.boringSite_);
+    const cookies = ContentSettingsTypes.COOKIES;
+    if (e.detail) {
+      this.browserProxy.setCategoryPermissionForPattern(
+          pattern, '*', cookies, ContentSetting.SESSION_ONLY, false);
+      return;
+    }
+    this.browserProxy.resetCategoryPermissionForPattern(
+        pattern, '*', cookies, false);
+    // Where every site clears already, resetting this one gives that
+    // back, so say keep for this site outright.
+    this.browserProxy.getDefaultValueForContentType(cookies).then(
+        (everySite) => {
+          if (everySite.setting === ContentSetting.SESSION_ONLY) {
+            this.browserProxy.setCategoryPermissionForPattern(
+                pattern, '*', cookies, ContentSetting.ALLOW, false);
+          }
+        });
+  }
+
