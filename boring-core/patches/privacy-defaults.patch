@@ -26,10 +26,22 @@ DefaultDnsOverHttpsConfigSource::DefaultDnsOverHttpsConfigSource(
   // Changing prefs or defaults after registering change callbacks could
   // result in reentrancy and mess up registration between this code and
   // NetworkService creation.
+  // boring: secure DNS through Quad9 (https://quad9.net), a Swiss
+  // non-profit resolver that refuses to resolve known malware and
+  // phishing domains. This is the browser's malicious site protection:
+  // no blocklist is shipped or downloaded, the resolver simply does not
+  // answer for those names. Secure mode, not automatic, so a network
+  // cannot quietly fall back to a resolver that does not filter, and so
+  // Settings shows the provider actually in use. Settings, Privacy and
+  // security, Security, "Use secure DNS" changes or turns it off, and
+  // Chromium still turns it off by itself on managed machines.
   if (set_up_pref_defaults) {
     local_state->SetDefaultPrefValue(prefs::kDnsOverHttpsMode,
                                      base::Value(SecureDnsConfig::ModeToString(
-                                         net::SecureDnsMode::kOff)));
+                                         net::SecureDnsMode::kSecure)));
+    local_state->SetDefaultPrefValue(
+        prefs::kDnsOverHttpsTemplates,
+        base::Value("https://dns.quad9.net/dns-query"));
   }
 }
 
