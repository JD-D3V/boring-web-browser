+      /* Content-box divider hooks, see settings-restyle.patch's .hr/.cr-row
+       * (cr_shared_style_lit.css) for the full explanation: byte-for-byte
+       * the old flush border-top by default, inset to this row's own text
+       * when settings-restyle's settings-section/settings-subpage scope
+       * turns the two vars on. #sync-not-allowed is also class="cr-row",
+       * so it already carries the standard 20px --cr-section-padding
+       * inline padding for content-box to use - unlike appearance_page's
+       * #toolbarRow, this one isn't an unpadded wrapper. background-color
+       * is split out from the old "background" shorthand so the new
+       * background-image (the divider line) can layer on top of the grey
+       * fill instead of the shorthand resetting it away. */
       #sync-not-allowed {
-        border-top: var(--cr-separator-line);
-        background:  var(--google-grey-100);
+        background-color: var(--google-grey-100);
+        background-image: var(--cr-row-divider-background, none);
+        background-origin: content-box;
+        background-position: top;
+        background-repeat: no-repeat;
+        background-size: 100% var(--cr-separator-height);
+        border-top: var(--cr-row-divider-border, var(--cr-separator-line));
       }
 
