 void TabIcon::SetDiscarded(bool discarded) {
+  // boring: a gentle dim on sleep and back on wake, whether or not the
+  // discard ring is on. RichAnimationDuration() is zero with Windows
+  // "Animation effects" off, so then it simply changes.
+  if (discarded != is_discarded_) {
+    sleep_dim_animation_.SetSlideDuration(
+        gfx::Animation::RichAnimationDuration(base::Milliseconds(200)));
+    if (discarded) {
+      sleep_dim_animation_.Show();
+    } else {
+      sleep_dim_animation_.Hide();
+    }
+  }
   is_discarded_ = discarded;
   bool show_discard_indicator =
       is_discarded_ && discard_ring_treatment_enabled_;
