+void RenderViewContextMenu::BoringSummarizePage() {
+  content::RenderFrameHost* frame = GetRenderFrameHost();
+  if (!frame) {
+    return;
+  }
+  // Read the visible text of the page, then put it aside. Nothing is
+  // sent anywhere here; the person confirms that on the next screen.
+  const std::string title =
+      base::UTF16ToUTF8(source_web_contents_->GetTitle());
+  const std::string url = params_.page_url.spec();
+  base::WeakPtr<content::WebContents> contents =
+      source_web_contents_->GetWeakPtr();
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      u"document.body ? document.body.innerText : ''",
+      base::BindOnce(
+          [](std::string title, std::string url,
+             base::WeakPtr<content::WebContents> contents, base::Value result) {
+            if (!contents) {
+              return;
+            }
+            const std::string* text = result.GetIfString();
+            // The service belongs to this profile, so a page read in an
+            // incognito window is never held where an ordinary window
+            // could ask for a summary of it.
+            boring::ai::AiSummaryService* service =
+                boring::ai::AiSummaryService::GetForBrowserContext(
+                    contents->GetBrowserContext());
+            if (!service) {
+              return;
+            }
+            service->HoldPage(title, url, text ? *text : std::string());
+            contents->OpenURL(
+                content::OpenURLParams(
+                    GURL("chrome://boring-ai"), content::Referrer(),
+                    WindowOpenDisposition::NEW_FOREGROUND_TAB,
+                    ui::PAGE_TRANSITION_AUTO_TOPLEVEL, false),
+                /*navigation_handle_callback=*/{});
+          },
+          title, url, contents),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
+
+void RenderViewContextMenu::BoringOpenReaderView() {
+  content::RenderFrameHost* frame = GetRenderFrameHost();
+  if (!frame) {
+    DistillCurrentPageAndViewIfSuccessful(source_web_contents_,
+                                          base::DoNothing());
+    return;
+  }
+  // Ask the live page which paragraph has been reached, then open reader
+  // view there instead of back at the top of the article.
+  base::WeakPtr<content::WebContents> contents =
+      source_web_contents_->GetWeakPtr();
+  frame->ExecuteJavaScriptInIsolatedWorld(
+      base::UTF8ToUTF16(std::string(boring::kReaderAnchorScript)),
+      base::BindOnce(
+          [](base::WeakPtr<content::WebContents> contents,
+             base::Value result) {
+            if (!contents) {
+              return;
+            }
+            boring::ReaderScrollKeeper::Remember(contents.get(), result);
+            DistillCurrentPageAndViewIfSuccessful(contents.get(),
+                                                  base::DoNothing());
+          },
+          contents),
+      ISOLATED_WORLD_ID_CHROME_INTERNAL);
+}
