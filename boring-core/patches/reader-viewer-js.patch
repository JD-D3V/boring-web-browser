+
+// boring: show an estimated reading time under the title. The article
+// arrives a piece at a time, so watch the content and update as it
+// grows. 220 words a minute is an average adult reading speed.
+function boringUpdateReadTime() {
+  const line = document.getElementById('boring-read-time');
+  const content = document.getElementById('content');
+  if (!line || !content) {
+    return;
+  }
+  const words = (content.innerText || '').split(/\s+/).filter(
+      (word) => word.length > 0).length;
+  if (words < 50) {
+    line.textContent = '';
+    return;
+  }
+  const minutes = Math.max(1, Math.round(words / 220));
+  line.textContent = minutes === 1 ? '1 minute read' : minutes + ' minute read';
+}
+
+function boringStartReadTime() {
+  boringUpdateReadTime();
+  const content = document.getElementById('content');
+  if (content) {
+    new MutationObserver(boringUpdateReadTime).observe(
+        content, {subtree: true, childList: true, characterData: true});
+  }
+}
