 #include "content/public/browser/web_contents.h"
 #include "content/public/common/buildflags.h"
 #include "extensions/buildflags/buildflags.h"
@@ -549,6 +554,20 @@ void TabHelpers::AttachTabHelpers(WebContents* web_contents,
   blocked_content::PopupOpenerTabHelper::CreateForWebContents(
       web_contents, base::DefaultTickClock::GetInstance(),
       HostContentSettingsMapFactory::GetForProfile(profile));
+  boring::SerpTabHelper::CreateForWebContents(web_contents);
+  // Opening a tab is a quiet moment to see whether the blocking lists
+  // have been replaced. Not in incognito: this has nothing to do with
+  // what is being browsed and should not ride on a session that is
+  // meant to disappear.
+  if (!profile->IsOffTheRecord()) {
+    boring::ListUpdater::GetInstance()->MaybeCheck(
+        profile->GetPrefs(), profile->GetDefaultStoragePartition()
+                                 ->GetURLLoaderFactoryForBrowserProcess());
+  }
+  // The browser updater starts with the first tab of the session and
+  // then keeps its own schedule. It closes the browser the normal way
+  // when an update has been downloaded, checked and started.
+  boring::BrowserUpdater::StartOnce(base::BindRepeating(&chrome::AttemptExit));
   if (predictors::LoadingPredictorFactory::GetForProfile(profile)) {
     predictors::LoadingPredictorTabHelper::CreateForWebContents(web_contents);
   }
