diff --git a/chrome/browser/resources/settings/boring_page/boring_protection_page.ts b/chrome/browser/resources/settings/boring_page/boring_protection_page.ts
new file mode 100644
--- /dev/null
+++ b/chrome/browser/resources/settings/boring_page/boring_protection_page.ts
@@ -0,0 +1,122 @@
+// Copyright 2026 boring. BSD style license.
+
+/**
+ * @fileoverview
+ * 'boring-protection-page' is the real settings page for scam, ad and
+ * tracker protection. The switches here bind to the actual boring.* prefs,
+ * never to simulated state. Live service status (whether the scam and ad
+ * lists actually loaded, and how old they are) already has a home at
+ * chrome://boring-protection, which polls the real blocking services; this
+ * page links there rather than re-implementing that polling, so nothing
+ * shown here can drift from what the browser is actually doing.
+ */
+import 'chrome://resources/cr_elements/cr_link_row/cr_link_row.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import '../controls/settings_toggle_button.js';
+import '../settings_page/settings_section.js';
+import '../settings_shared.css.js';
+
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {loadTimeData} from '../i18n_setup.js';
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+
+import {getTemplate} from './boring_protection_page.html.js';
+
+const BoringProtectionPageElementBase = PrefsMixin(PolymerElement);
+
+export class BoringProtectionPageElement extends
+    BoringProtectionPageElementBase implements SettingsPlugin {
+  static get is() {
+    return 'boring-protection-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      /**
+       * Set from the --senior-safe-mode command line switch. When true,
+       * Senior Safe Mode cannot be changed here, or anywhere else in the
+       * browser; see boring::IsSeniorSafeModeForced().
+       */
+      seniorForced_: {
+        type: Boolean,
+        value: () => loadTimeData.getBoolean('boringSeniorForced'),
+      },
+    };
+  }
+
+  declare private seniorForced_: boolean;
+
+  /**
+   * True when Senior Safe Mode is in effect, whether that came from the
+   * stored pref or from the command line switch.
+   */
+  private isSeniorOn_(seniorPref: boolean, seniorForced: boolean): boolean {
+    return seniorPref || seniorForced;
+  }
+
+  private computeSeniorSubLabel_(seniorForced: boolean): string {
+    if (seniorForced) {
+      return 'Turned on for this computer.';
+    }
+    return 'Hide sponsored results and remove the option to bypass known ' +
+        'scam warnings.';
+  }
+
+  private onSeniorChange_(e: CustomEvent<boolean>) {
+    if (this.seniorForced_) {
+      // Nothing on this computer can turn this back off, so a stray event
+      // should not try.
+      return;
+    }
+    this.setPrefValue('boring.senior_safe_mode', e.detail);
+  }
+
+  /**
+   * Senior Safe Mode also hides sponsored results, so the switch reads on
+   * even when the underlying pref is off. The stored pref is left alone:
+   * turning Senior Safe Mode back off later should not have quietly turned
+   * this one on for good.
+   */
+  private computeHideSponsoredChecked_(
+      hideSponsored: boolean, seniorOn: boolean): boolean {
+    return hideSponsored || seniorOn;
+  }
+
+  private onHideSponsoredChange_(e: CustomEvent<boolean>) {
+    if (this.isSeniorOn_(
+            this.getPref<boolean>('boring.senior_safe_mode').value,
+            this.seniorForced_)) {
+      // The toggle is disabled whenever Senior Safe Mode is on, so this
+      // should not be reachable. Guarding it anyway means a stray event can
+      // never overwrite the real pref with a forced display value.
+      return;
+    }
+    this.setPrefValue('boring.hide_sponsored_results', e.detail);
+  }
+
+  private onProtectionDetailsClick_() {
+    window.open('chrome://boring-protection');
+  }
+
+  // SettingsPlugin implementation
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'boring-protection-page': BoringProtectionPageElement;
+  }
+}
+
+customElements.define(
+    BoringProtectionPageElement.is, BoringProtectionPageElement);
