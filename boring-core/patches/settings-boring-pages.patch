@@ -0,0 +1,98 @@
+// Copyright 2026 boring. BSD style license.
+
+/**
+ * @fileoverview
+ * 'boring-summaries-page' shows the real, current page summaries provider
+ * and links to chrome://boring-ai, which keeps the actual provider, model
+ * and API key setup along with the existing consent flow. The API key
+ * itself is never exposed to settings; only the provider name is, and only
+ * to read it, never to change it from here.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import '../settings_page/settings_section.js';
+import '../settings_shared.css.js';
+
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getSearchManager} from '../search_settings.js';
+import type {SettingsPlugin} from '../settings_main/settings_plugin.js';
+
+import {getTemplate} from './boring_summaries_page.html.js';
+
+// Matches the provider names ai_ui.cc's own setup screen uses, so the
+// label here never disagrees with the page it links to.
+const PROVIDER_ROW_NAMES: Record<string, string> = {
+  ollama: 'Ollama on this computer',
+  gemini: 'Google Gemini',
+  openai: 'OpenAI',
+  openrouter: 'OpenRouter',
+  groq: 'Groq',
+};
+
+// What DescribeDestination() in components/boring/ai/ai_prefs.cc calls each
+// service. The exact address (including whether a chosen Ollama address is
+// actually local) is only known and confirmed right before a summary is
+// sent, on the consent screen at chrome://boring-ai; this page does not
+// repeat that check.
+const PROVIDER_DESTINATION_NAMES: Record<string, string> = {
+  gemini: 'Google Gemini',
+  openai: 'OpenAI',
+  openrouter: 'OpenRouter',
+  groq: 'Groq',
+};
+
+const BoringSummariesPageElementBase = PrefsMixin(PolymerElement);
+
+export class BoringSummariesPageElement extends
+    BoringSummariesPageElementBase implements SettingsPlugin {
+  static get is() {
+    return 'boring-summaries-page';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  private computeProviderLabel_(provider: string): string {
+    if (!provider || provider === 'off') {
+      return 'Off';
+    }
+    return PROVIDER_ROW_NAMES[provider] || 'Off';
+  }
+
+  private computeDestinationNote_(provider: string): string {
+    if (provider === 'ollama') {
+      return 'Summaries would run on your own computer. The exact ' +
+          'address is confirmed each time, right before anything is sent.';
+    }
+    const name = PROVIDER_DESTINATION_NAMES[provider];
+    if (name) {
+      return `Page text would be sent to ${name}. You are asked to ` +
+          'confirm this, with the exact destination named, before ' +
+          'anything is sent.';
+    }
+    return 'Nothing is sent anywhere. Page summaries are off until you ' +
+        'choose a service.';
+  }
+
+  private onSetUpClick_() {
+    window.open('chrome://boring-ai');
+  }
+
+  // SettingsPlugin implementation
+  async searchContents(query: string) {
+    const searchRequest = await getSearchManager().search(query, this);
+    return searchRequest.getSearchResult();
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'boring-summaries-page': BoringSummariesPageElement;
+  }
+}
+
+customElements.define(
+    BoringSummariesPageElement.is, BoringSummariesPageElement);
