+
+  // boring: test hook. Photographing the focused address bar and its
+  // glow means focusing it without sending input to the desktop, as
+  // --boring-open-app-menu does for the main menu. Does nothing unless
+  // the switch is given.
+  if (base::CommandLine::ForCurrentProcess()->HasSwitch(
+          "boring-focus-omnibox")) {
+    base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+        FROM_HERE,
+        base::BindOnce(
+            [](base::WeakPtr<LocationBarView> bar) {
+              if (bar) {
+                bar->FocusLocation(/*is_user_initiated=*/true);
+              }
+            },
+            weak_factory_.GetWeakPtr()),
+        base::Seconds(4));
+  }
