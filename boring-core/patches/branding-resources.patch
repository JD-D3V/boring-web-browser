-bool ShouldThemifyFavicon(GURL url) {
+namespace {
+
+// boring: browser-owned pages whose favicon is the B mark (a teal plate).
+// The plate is the brand colour, so it is never recoloured: the contrast
+// check would otherwise turn it into a solid white square on dark tabs.
+bool IsBoringBrandFaviconUrl(const GURL& url) {
   if (!url.SchemeIs(content::kChromeUIScheme)) {
     return false;
   }
+  return url.host() == chrome::kChromeUISettingsHost ||
+         url.host() == "boring-newtab" || url.host() == "boring-protection" ||
+         url.host() == "boring-ai" || url.host() == "boring-welcome";
+}
+
+}  // namespace
+
+bool ShouldThemifyFavicon(GURL url) {
+  if (!url.SchemeIs(content::kChromeUIScheme) ||
+      IsBoringBrandFaviconUrl(url)) {
+    return false;
+  }
   return url.host() != chrome::kChromeUIAppLauncherPageHost &&
          url.host() != chrome::kChromeUIHelpHost &&
          url.host() != chrome::kChromeUIVersionHost &&
@@ -197,6 +214,13 @@ bool ShouldThemifyFaviconForEntry(content::NavigationEntry* entry) {
   const GURL& virtual_url = entry->GetVirtualURL();
   const GURL& actual_url = entry->GetURL();
 
+  // boring: our new tab page may commit as chrome://boring-newtab under a
+  // chrome://newtab virtual URL (or the reverse); either way it is the B.
+  if (IsBoringBrandFaviconUrl(virtual_url) ||
+      IsBoringBrandFaviconUrl(actual_url)) {
+    return false;
+  }
+
   if (ShouldThemifyFavicon(virtual_url)) {
     return true;
   }
