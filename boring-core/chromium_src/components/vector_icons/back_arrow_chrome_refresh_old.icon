// The back arrow from the V2 icon family (design/v2/icons.js "back"):
// a right-angle chevron and a shaft, 24 grid scaled to this 20 canvas,
// stroke 1.7/24 of the size. Centred in the canvas (the V2 path sits
// 2 units right of centre). Used whenever rounded icons are off, which
// is our default.

CANVAS_DIMENSIONS, 20,
STROKE, 1.42,
MOVE_TO, 10, 4.17,
LINE_TO, 4.17, 10,
LINE_TO, 10, 15.83,
MOVE_TO, 4.17, 10,
LINE_TO, 15.83, 10,
