// The bookmark star for a page that is not yet bookmarked, from the V2
// icon family (icons.js "star"), 24 grid scaled to this 20 canvas. The
// bookmarked (filled) state keeps Chromium's own icon, since a solid
// fill is exactly what should change when the toggle flips.

CANVAS_DIMENSIONS, 20,
STROKE, 1.42,
MOVE_TO, 10, 2.5,
LINE_TO, 12.33, 7.25,
LINE_TO, 17.5, 8,
LINE_TO, 13.75, 11.67,
LINE_TO, 14.67, 16.83,
LINE_TO, 10, 14.33,
LINE_TO, 5.33, 16.83,
LINE_TO, 6.25, 11.67,
LINE_TO, 2.5, 8,
LINE_TO, 7.67, 7.25,
CLOSE,
